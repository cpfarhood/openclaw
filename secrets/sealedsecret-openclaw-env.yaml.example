---
# Example SealedSecret for OpenClaw environment variables
# To create the actual secret:
#
# 1. Create a temporary secret file:
#    kubectl create secret generic openclaw-env-secret \
#      --namespace=openclaw \
#      --from-literal=GOOGLE_GENERATIVE_AI_API_KEY='your-gemini-api-key' \
#      --from-literal=TELEGRAM_BOT_TOKEN='your-telegram-token' \
#      --from-literal=DISCORD_BOT_TOKEN='your-discord-token' \
#      --from-literal=SLACK_BOT_TOKEN='your-slack-bot-token' \
#      --from-literal=SLACK_APP_TOKEN='your-slack-app-token' \
#      --dry-run=client -o yaml | \
#      kubeseal --format yaml > sealedsecret-openclaw-env.yaml
#
# 2. Add the sealed secret to git (safe - encrypted)
# 3. Delete this example file
#
# Required keys:
# - GOOGLE_GENERATIVE_AI_API_KEY: Your Google API key for Gemini models
#
# Optional keys (for messaging platforms):
# - TELEGRAM_BOT_TOKEN: Telegram bot token
# - DISCORD_BOT_TOKEN: Discord bot token
# - SLACK_BOT_TOKEN: Slack bot user OAuth token
# - SLACK_APP_TOKEN: Slack app-level token (for Socket Mode)
#
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: openclaw-env-secret
  namespace: openclaw
spec:
  encryptedData:
    # Run the kubectl create secret command above to generate these
    GOOGLE_GENERATIVE_AI_API_KEY: REPLACE_WITH_SEALED_VALUE
    # Optional: Add encrypted values for messaging platforms
    # TELEGRAM_BOT_TOKEN: REPLACE_WITH_SEALED_VALUE
    # DISCORD_BOT_TOKEN: REPLACE_WITH_SEALED_VALUE
    # SLACK_BOT_TOKEN: REPLACE_WITH_SEALED_VALUE
    # SLACK_APP_TOKEN: REPLACE_WITH_SEALED_VALUE
  template:
    metadata:
      name: openclaw-env-secret
      namespace: openclaw
    type: Opaque
